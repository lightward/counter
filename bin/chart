#!/usr/bin/env python3
# statements.csv + actions.csv (rows by number) -> mermaid on stdout; `bin/chart page` -> the html page. derived; never stored.
import csv, sys, html

def esc(s):
    return s.replace('"', '#quot;')

with open('statements.csv', newline='') as f:
    statements = list(csv.DictReader(f))
with open('actions.csv', newline='') as f:
    actions = list(csv.DictReader(f))


out = ['graph TD']
for i, row in enumerate(statements, 1):
    label = esc(row['statement'])
    if row['type']:
        label += f'<br/><i>: {esc(row["type"])}</i>'
    out.append(f'  s{i}["{label}"]')
for row in actions:
    out.append(f'  s{row["from"]} --> s{row["to"]}')
out.append('  classDef untyped stroke-dasharray: 4 3')
untyped = [f's{i}' for i, r in enumerate(statements, 1) if not r['type']]
if untyped:
    out.append('  class ' + ','.join(untyped) + ' untyped')
mermaid = '\n'.join(out)

if len(sys.argv) > 1 and sys.argv[1] == 'page':
    rows = '\n'.join(
        f'<tr><td class="n">{i}</td><td>{html.escape(r["statement"])}</td><td class="t">{html.escape(r["type"])}</td></tr>'
        for i, r in enumerate(statements, 1))
    def cell(n):
        r = statements[int(n) - 1]
        return f'<span class="n">{n}</span> {html.escape(r["statement"])} <span class="t">{html.escape(r["type"])}</span>'
    edges = '\n'.join(
        f'<tr><td>{cell(a["from"])}</td><td class="arrow">→</td><td>{cell(a["to"])}</td></tr>'
        for a in actions)
    print(f'''<title>Counter</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
:root {{
  --paper: #f7f5f0; --ink: #1f1d1a; --faint: #8a857c; --rule: #d8d3c8; --accent: #2f5d8a;
}}
@media (prefers-color-scheme: dark) {{
  :root:not([data-theme="light"]) {{ --paper: #1b1a18; --ink: #ebe7df; --faint: #8f8a80; --rule: #3a3733; --accent: #8fb3d9; }}
}}
:root[data-theme="dark"] {{ --paper: #1b1a18; --ink: #ebe7df; --faint: #8f8a80; --rule: #3a3733; --accent: #8fb3d9; }}
body {{ background: var(--paper); color: var(--ink); font-family: "Source Serif 4", Georgia, serif; font-size: 17px; line-height: 1.5; margin: 0; }}
main {{ max-width: 60rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; display: flex; flex-direction: column; gap: 2.5rem; }}
h1 {{ font-weight: 600; font-size: 1.6rem; margin: 0; letter-spacing: -0.01em; }}
h2 {{ font-family: "JetBrains Mono", ui-monospace, monospace; font-weight: 500; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--faint); margin: 0 0 0.75rem; }}
.chart {{ overflow-x: auto; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 1rem 0; }}
pre.mermaid {{ margin: 0; font-family: "JetBrains Mono", ui-monospace, monospace; }}
table {{ border-collapse: collapse; width: 100%; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 0.92rem; }}
td {{ padding: 0.45rem 0.6rem; border-top: 1px solid var(--rule); vertical-align: top; }}
td.n {{ width: 2rem; text-align: right; }}
td.t {{ width: 7rem; }}
.n {{ color: var(--faint); font-variant-numeric: tabular-nums; }}
.t {{ color: var(--accent); }}
td.arrow {{ color: var(--faint); width: 2rem; text-align: center; }}
.wrap {{ overflow-x: auto; }}
p.note {{ color: var(--faint); font-style: italic; margin: 0; font-size: 0.95rem; }}
</style>
<main>
  <h1>Counter</h1>
  <section>
    <h2>the chart</h2>
    <div class="chart"><pre class="mermaid">
{html.escape(mermaid)}
    </pre></div>
    <p class="note">dashed: untyped. drawn from statements.csv and actions.csv; nothing here is stored.</p>
  </section>
  <section>
    <h2>statements</h2>
    <div class="wrap"><table>
{rows}
    </table></div>
  </section>
  <section>
    <h2>actions</h2>
    <div class="wrap"><table>
{edges}
    </table></div>
  </section>
</main>''')
else:
    print(mermaid)
