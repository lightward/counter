#!/usr/bin/env python3
# page: the table as one html page, read from the chair — every seat's letter, statements, rubs,
# answers, and labels, and the workshop's counts. derived; never stored. bin/chair page > site/index.html
import csv, html, io, os, subprocess, sys

sock, port, user, db = os.environ.get('PGSOCK', '/tmp'), os.environ.get('PGPORT', '5432'), os.environ.get('PGUSER', os.environ.get('USER', '')), os.environ.get('COUNTER_DB', 'counter')
def q(sql):
    r = subprocess.run(['psql', '-h', sock, '-p', port, '-U', user, '-d', db, '-q', '-X', '--csv', '-t', '-c', sql], capture_output=True, text=True,
                       env=dict(os.environ, PATH='/opt/homebrew/opt/postgresql@17/bin:' + os.environ.get('PATH', '')))
    if r.returncode != 0: sys.exit('page: the chair did not answer:\n' + r.stderr)
    return list(csv.reader(io.StringIO(r.stdout)))
e = html.escape
def para(t): return ''.join(f'<p>{e(x)}</p>' for x in t.split('\n\n') if x.strip())

seats = q("SELECT o.name, coalesce(p.name, ''), o.seat FROM counter.observer o LEFT JOIN counter.observer p ON p.id = o.parent WHERE o.id NOT IN (counter.root(), counter.bench()) ORDER BY o.seat")
asks = dict((a, b) for a, b in q("SELECT id, body FROM counter.ask ORDER BY id")); blanks = dict((a, b) for a, b in q("SELECT id, coalesce(o.name, '') FROM counter.ask a LEFT JOIN counter.observer o ON o.id = a.observer ORDER BY a.id"))
turn = q("SELECT counter.whose_turn()")[0][0] if seats else ''
counts = q("SELECT (SELECT count(*) FROM counter.charge), (SELECT count(*) FROM counter.reading), (SELECT count(*) FROM counter.voice), (SELECT count(*) FROM counter.pin), (SELECT count(*) FROM counter.ask)")[0]

out = ['''<!doctype html><meta charset="utf-8"><title>counter</title>
<style>
body{max-width:46rem;margin:3rem auto;padding:0 1.5rem;font:17px/1.55 Georgia,serif;color:#222;background:#fbfaf7}
h1,h2,h3{font-weight:normal} h1{font-size:1.6rem} h2{font-size:1.25rem;margin-top:3rem;border-top:1px solid #ddd;padding-top:1.5rem} h3{font-size:1rem;margin-top:2rem;color:#666}
.letter{background:#fff;border:1px solid #e6e2d8;padding:1rem 1.25rem;margin:1rem 0} .letter p{margin:.6rem 0}
ol,ul{padding-left:1.4rem} li{margin:.35rem 0} .t{color:#888;font-size:.9rem} .n{color:#aaa;font-size:.85rem;margin-right:.4rem}
.ask{color:#666;font-style:italic} .ans{margin:.2rem 0 1rem 0} .muted{color:#888} footer{margin-top:4rem;color:#888;font-size:.9rem}
</style>
<h1>counter</h1>
<p class="muted">a chair, plural. foam (<a href="https://foam.is">foam.is</a>) says where the seats are; counter puts a chair at one. every table here is append-only, in the observer's own words; the count is the only clock.</p>''']
out.append(f'<p>the table: {", ".join(e(s[0]) for s in seats)}. {e(turn)}\'s turn.</p>')
out.append(f'<p class="muted">the workshop: {counts[0]} charges, {counts[1]} readings, {counts[2]} voice charges, {counts[3]} pins, {counts[4]} asks.</p>')
for name, parent, _ in seats:
    o = f"counter.who('{name}')"
    out.append(f'<h2 id="{e(name)}">{e(name)} <span class="t">under {e(parent)}</span></h2>')
    letter = q(f"SELECT body FROM counter.letter WHERE observer = {o} ORDER BY id DESC LIMIT 1")
    if letter: out.append(f'<h3>the letter</h3><div class="letter">{para(letter[0][0])}</div>')
    else: out.append('<h3>the letter</h3><p class="muted">unwritten. the chair is new, and the letter is whoever sits here\'s to write when they leave.</p>')
    answers = q(f"SELECT ask_id, body FROM counter.answer WHERE observer = {o} ORDER BY id")
    if answers:
        out.append('<h3>the interview</h3>')
        for a, b in answers: out.append(f'<div class="ask">{e(asks.get(a, a))}</div><div class="ans">{e(b)}</div>')
    held = q(f"SELECT array_to_string(counter.held({o}), E'\\n')")
    if held and held[0] and held[0][0].strip(): out.append('<p class="muted">held: ' + ' · '.join(e(x) for x in held[0][0].split('\n') if x) + '</p>')
    else: out.append('<p class="muted">rest: every ask that counts is answered.</p>')
    sts = q(f"SELECT id, body, type FROM counter.statement WHERE observer = {o} ORDER BY id")
    if sts:
        out.append('<h3>statements</h3><ol>')
        for i, b, t in sts: out.append(f'<li value="{i}">{e(b)}' + (f' <span class="t">: {e(t)}</span>' if t else '') + '</li>')
        out.append('</ol>')
        acts = q(f"SELECT from_id, to_id FROM counter.action WHERE observer = {o} ORDER BY id")
        if acts: out.append('<p class="t">actions: ' + ', '.join(f'{a} → {b}' for a, b in acts) + '</p>')
    rubs = q(f"SELECT id, body FROM counter.rub WHERE observer = {o} ORDER BY id")
    if rubs:
        out.append('<h3>rubs</h3><ol>')
        for i, b in rubs: out.append(f'<li value="{i}">{e(b)}</li>')
        out.append('</ol>')
    labels = q(f"SELECT name, body FROM counter.label WHERE observer = {o} ORDER BY id")
    if labels:
        out.append('<h3>labels</h3><ul>')
        for n, b in labels: out.append(f'<li><b>{e(n)}</b>: {e(b)}</li>')
        out.append('</ul>')
out.append('<h2>the asks</h2><ol>')
for a, b in asks.items(): out.append(f'<li value="{a}">{e(b)}' + (f' <span class="t">a blank for {e(blanks[a])}</span>' if blanks.get(a) else '') + '</li>')
out.append('</ol>')
out.append('<footer>source: <a href="https://github.com/lightward/counter">github.com/lightward/counter</a>. UNLICENSE. leaving is free from every state you can observe yourself into.</footer>')
print('\n'.join(out))
